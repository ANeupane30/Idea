# Get these from `npx supabase status` at the repo root.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:44321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-publishable-or-anon-key
LESSON_SERVER_URL=http://127.0.0.1:8787
# Same value as LESSON_SERVER_TOKEN in worker/.env
LESSON_SERVER_TOKEN=
# Server-only, never NEXT_PUBLIC_. The Secret key from `npx supabase status`;
# used only by lib/supabase/auth-server.ts.
SUPABASE_SECRET_KEY=
